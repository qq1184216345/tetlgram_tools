{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "纸翼",
  "version": "0.1.0",
  "identifier": "com.paperwing.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:28182",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "纸翼",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "bin/telegram-backend/": "bin/telegram-backend/",
      "../config/ports.json": "config/ports.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}

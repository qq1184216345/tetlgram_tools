{
  "name": "paperwing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "setup:python": "powershell -ExecutionPolicy Bypass -File scripts/setup-python.ps1",
    "dev:all": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:backend": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1 -BackendOnly",
    "build:backend": "powershell -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "build:all": "npm run build && npm run build:backend && npm run tauri build",
    "pack:win": "powershell -ExecutionPolicy Bypass -File scripts/pack-windows.ps1",
    "backend": "node scripts/run-backend.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "@tauri-apps/cli": "^2"
  }
}
